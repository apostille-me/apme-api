BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,tower_http=info
DATABASE_URL=postgres://apme_api:replace-me@127.0.0.1:5432/apme
SHARED_AUTH_BASE_URL=https://auth.example.invalid
SHARED_AUTH_ISSUER=https://auth.example.invalid/realms/apostille-me
SHARED_AUTH_AUDIENCE=apostille-me
SHARED_AUTH_INTROSPECTION_CREDENTIAL=replace-with-independent-service-credential

# Optional stateful mTLS listener. When APME_API_TCP_BIND is set, all certificate
# paths below become mandatory and startup fails closed if any is invalid.
# APME_API_TCP_BIND=127.0.0.1:9443
# APME_API_TCP_TLS_CERT_FILE=/run/secrets/apme-api.crt
# APME_API_TCP_TLS_KEY_FILE=/run/secrets/apme-api.key
# APME_API_TCP_CLIENT_CA_FILE=/run/secrets/apme-web-client-ca.crt

# Optional durable status worker. Credentials never belong in the URL or Git.
# APME_NATS_URL=tls://nats.internal:4222
# APME_NATS_CREDENTIALS_FILE=/run/secrets/apme-api.creds
