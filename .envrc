watch_file .nix/flake.nix
watch_file .nix/flake.lock
use flake ./.nix

# Deliberately does NOT load secrets: an auto-loaded secret is in the
# environment of every subprocess started from this directory (package-manager
# install hooks, editors, agents). Activate one explicitly instead:
#     just env-use dev        # .env -> env/dec/dev.env
#     just env-run dev <cmd>  # no file at all
